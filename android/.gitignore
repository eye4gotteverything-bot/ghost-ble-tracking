# Gradle / Android build output
.gradle/
build/
app/build/
local.properties
*.apk
*.aab
*.apks

# Gradle wrapper jar is generated by `gradle wrapper` / Android Studio —
# do not hand-commit a jar you did not generate.
# (gradle-wrapper.properties IS committed on purpose.)

# IDE
.idea/
*.iml
.vscode/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Signing — NEVER commit keystores or passwords
*.jks
*.keystore
keystore.properties

# Environment / secrets — never commit these
.env
.env.*
!.env.example
